      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0"
    }
  },
  "dependencies": {
    "@srcery-colors/srcery-palette": "^2.1.0",
    "sharp": "^0.34.5"
  }
}
