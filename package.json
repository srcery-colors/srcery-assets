{
  "name": "srcery-assets",
  "version": "0.0.1",
  "description": "Node scripts for generating assets",
  "private": true,
  "main": "src/swatch.js",
  "scripts": {
    "swatch": "node src/swatch.mjs"
  },
  "keywords": ["colors","colorscheme","swatch"],
  "author": "Daniel Berg",
  "license": "CC-BY-4.0",
  "devEngines": {
    "runtime": {
      "name": "node",
